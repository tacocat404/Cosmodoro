# Copy to .env for local runs; on the host, set these as secrets. Nothing here is needed for `npm run dev`.
# A long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The public address, e.g. https://cosmodoro.vercel.app
BETTER_AUTH_URL=http://localhost:8787
# Local SQLite file (ignored when DATABASE_URL is set)
DB_PATH=cosmodoro.db
# The header the host puts the real client IP in (Vercel: x-real-ip). Leave empty locally.
IP_HEADER=
# Google sign-in (optional): the button only shows when these are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Postgres (Neon). Set on Vercel by the Neon integration; leave empty to use the SQLite file
DATABASE_URL=
