# Copy to .env for local runs; on the host, set these as secrets. Nothing here is needed for `npm run dev`.
# A long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The public address, e.g. https://cosmodoro.fly.dev
BETTER_AUTH_URL=http://localhost:8787
# Where the SQLite file goes (Dockerfile sets /data/cosmodoro.db)
DB_PATH=cosmodoro.db
# The header the host puts the real client IP in (Fly.io: fly-client-ip). Leave empty locally.
IP_HEADER=
# Google sign-in (optional): the button only shows when these are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
